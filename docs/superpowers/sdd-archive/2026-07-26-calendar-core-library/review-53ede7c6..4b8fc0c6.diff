+      "END:VEVENT",
+    ]);
+  }
+  return blocks;
+}
+
+function masterFeed(defs) {
+  const vevents = [];
+  for (const def of defs) {
+    if (def.mode === "recurring") vevents.push(...recurringVevents(def));
+    else vevents.push(...eventVevents(def));
+  }
+  return buildCalendar(vevents);
+}
