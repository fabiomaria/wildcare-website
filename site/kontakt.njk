---
permalink: kontakt.html
---
{%- set de = cms.pages.kontakt.de -%}
{%- set en = cms.pages.kontakt.en -%}
{%- set siteDe = cms.site.de -%}
{%- set siteEn = cms.site.en -%}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- set seoMeta = de.meta -%}
    {%- set seoCanonical = "https://wildcare.space/kontakt" -%}
    {%- set seoAlternateLocale = "en_US" -%}
    {% include "partials/seo.njk" %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,700;1,9..144,300;1,9..144,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="css/styles.css?v={{ assetVersion }}">
</head>
<body>

    {% set navActive = 'kontakt' %}{% include "partials/nav.njk" %}

    <!-- ================================
         HERO
         ================================ -->

    <header class="page-hero">
        <div class="container">
            <p class="label fade-up"
                data-de="{{ de.hero.label }}"
                data-en="{{ en.hero.label or de.hero.label }}">{{ de.hero.label }}</p>
            <h1 class="fade-up delay-1"
                data-de="{{ de.hero.heading }}"
                data-en="{{ en.hero.heading or de.hero.heading }}">{{ de.hero.heading | safe }}</h1>
            <p class="fade-up delay-2" style="max-width: 560px;"
                data-de="{{ de.hero.intro }}"
                data-en="{{ en.hero.intro or de.hero.intro }}">{{ de.hero.intro }}</p>
        </div>
    </header>

    <!-- ================================
         CONTACT FORM + INFO
         ================================ -->

    <section>
        <div class="container">
            <div class="kontakt-grid">

                <!-- LEFT: Form -->
                <div class="kontakt-form-wrapper fade-up">
                    <h3 data-de="{{ de.form.heading }}" data-en="{{ en.form.heading or de.form.heading }}">{{ de.form.heading }}</h3>
                    <form id="kontakt-form">
                        <div class="form-group">
                            <label for="name" data-de="{{ de.form.name_label }}" data-en="{{ en.form.name_label or de.form.name_label }}">{{ de.form.name_label }}</label>
                            <input type="text" id="name" name="name" placeholder="{{ de.form.name_placeholder }}" data-placeholder-de="{{ de.form.name_placeholder | attr }}" data-placeholder-en="{{ (en.form.name_placeholder or de.form.name_placeholder) | attr }}" maxlength="120" required>
                        </div>
                        <div class="form-group">
                            <label for="email" data-de="{{ de.form.email_label }}" data-en="{{ en.form.email_label or de.form.email_label }}">{{ de.form.email_label }}</label>
                            <input type="email" id="email" name="email" placeholder="{{ de.form.email_placeholder }}" data-placeholder-de="{{ de.form.email_placeholder | attr }}" data-placeholder-en="{{ (en.form.email_placeholder or de.form.email_placeholder) | attr }}" required>
                        </div>
                        <div class="form-group">
                            <label for="message" data-de="{{ de.form.message_label }}" data-en="{{ en.form.message_label or de.form.message_label }}">{{ de.form.message_label }}</label>
                            <textarea id="message" name="message" placeholder="{{ de.form.message_placeholder }}" data-placeholder-de="{{ de.form.message_placeholder | attr }}" data-placeholder-en="{{ (en.form.message_placeholder or de.form.message_placeholder) | attr }}" maxlength="1800" required></textarea>
                        </div>
                        <div class="form-submit-row">
                            <button type="submit" class="btn btn-primary" data-de="{{ de.form.submit_label }}" data-en="{{ en.form.submit_label or de.form.submit_label }}">{{ de.form.submit_label }}</button>
                            <p class="form-note">
                                <span data-de="{{ de.form.note }}" data-en="{{ en.form.note or de.form.note }}">{{ de.form.note }}</span>
                                <a href="mailto:hello@wildcare.space">hello@wildcare.space</a>
                            </p>
                        </div>
                        <input type="text" name="website" id="kontakt-website" tabindex="-1" autocomplete="off" hidden>
                        <div class="kontakt-highlight" id="kontakt-status" role="status" aria-live="polite" hidden>
                            <p id="kontakt-message"></p>
                        </div>
                    </form>
                </div>

                <!-- RIGHT: Info -->
                <div class="kontakt-info fade-up delay-2">
                    <div class="kontakt-info-intro">
                        <p class="label" data-de="{{ de.info.label }}" data-en="{{ en.info.label or de.info.label }}">{{ de.info.label }}</p>
                        <h2 data-de="{{ de.info.heading }}" data-en="{{ en.info.heading or de.info.heading }}">{{ de.info.heading }}</h2>
                        <p data-de="{{ de.info.intro }}" data-en="{{ en.info.intro or de.info.intro }}">{{ de.info.intro }}</p>
                    </div>

                    <div class="kontakt-info-item">
                        <div class="kontakt-info-icon">
                            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
                        </div>
                        <div class="kontakt-info-text">
                            <p class="label" data-de="{{ de.info.email_label }}" data-en="{{ en.info.email_label or de.info.email_label }}">{{ de.info.email_label }}</p>
                            <p><a href="mailto:hello@wildcare.space">hello@wildcare.space</a></p>
                        </div>
                    </div>

                    <div class="kontakt-info-item">
                        <div class="kontakt-info-icon">
                            <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><path d="M17.5 6.5h.01"/></svg>
                        </div>
                        <div class="kontakt-info-text">
                            <p class="label">Instagram</p>
                            <p><a href="https://instagram.com/wildcare.space" target="_blank" rel="noopener">@wildcare.space</a></p>
                        </div>
                    </div>

                    <div class="kontakt-info-item">
                        <div class="kontakt-info-icon">
                            <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div class="kontakt-info-text">
                            <p class="label" data-de="{{ de.info.address_label }}" data-en="{{ en.info.address_label or de.info.address_label }}">{{ de.info.address_label }}</p>
                            <p>Orpheumgasse 11<br>8020 Graz</p>
                        </div>
                    </div>

                    <div class="kontakt-info-item">
                        <div class="kontakt-info-icon">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                        </div>
                        <div class="kontakt-info-text">
                            <p class="label" data-de="{{ de.info.when_label }}" data-en="{{ en.info.when_label or de.info.when_label }}">{{ de.info.when_label }}</p>
                            <p data-de="{{ de.info.when_value }}" data-en="{{ en.info.when_value or de.info.when_value }}">{{ de.info.when_value }}</p>
                        </div>
                    </div>

                    <div class="kontakt-highlight">
                        <p data-de="{{ de.info.highlight }}"
                           data-en="{{ en.info.highlight or de.info.highlight }}">{{ de.info.highlight }}</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ================================
         MAP
         ================================ -->

    <section class="map-section">
        <div class="container">
            <div class="section-header fade-up" style="text-align: center; margin-bottom: 48px;">
                <p class="label" data-de="{{ de.map.label }}" data-en="{{ en.map.label or de.map.label }}">{{ de.map.label }}</p>
                <h2 data-de="{{ de.map.heading }}" data-en="{{ en.map.heading or de.map.heading }}">{{ de.map.heading }}</h2>
            </div>
            <div class="map-wrapper fade-up delay-1">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2718.4!2d15.4477!3d47.0707!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x476e35b0a0a0a0a1%3A0x0!2sOrpheumgasse%2011%2C%208020%20Graz!5e0!3m2!1sde!2sat!4v1"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Wild Care Standort: Orpheumgasse 11, 8020 Graz">
                </iframe>
            </div>
            <p class="map-caption fade-up delay-2"
                data-de="{{ de.map.caption }}"
                data-en="{{ en.map.caption or de.map.caption }}">{{ de.map.caption }}</p>
        </div>
    </section>

    <!-- ================================
         FOOTER
         ================================ -->

    {%- set pagePrimaryLocale = "de" -%}
    {%- set footerConnectHeadingDe = de.footer.connect_heading -%}
    {%- set footerConnectHeadingEn = en.footer.connect_heading -%}
    {% include "partials/footer.njk" %}

    <!-- ================================
         SCRIPTS
         ================================ -->

    <script>
        // Scroll animations
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px'
        });

        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

        // Mobile nav toggle
        const navToggle = document.querySelector('.nav-toggle');
        const navLinks = document.querySelector('.nav-links');
        if (navToggle) {
            navToggle.addEventListener('click', () => {
                navLinks.classList.toggle('open');
            });
        }
    </script>

    <script src="js/i18n.js"></script>
    <script>
        (function () {
            var form = document.getElementById('kontakt-form');
            if (!form) return;

            var WORKER_URL = 'https://wildcare-kontakt.fabiogerhold.workers.dev';

            form.addEventListener('submit', function (e) {
                e.preventDefault();

                var name = document.getElementById('name').value;
                var email = document.getElementById('email').value;
                var message = document.getElementById('message').value;
                var website = document.getElementById('kontakt-website').value;
                var lang = document.documentElement.lang || 'de';
                var messageEl = document.getElementById('kontakt-message');
                var statusEl = document.getElementById('kontakt-status');
                var submitButton = form.querySelector('button[type="submit"]');
                var succeeded = false;

                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.textContent = lang === 'en' ? {{ (en.form.submitting_label or de.form.submitting_label) | json | safe }} : {{ de.form.submitting_label | json | safe }};
                }
                statusEl.hidden = true;

                fetch(WORKER_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: name, email: email, message: message, website: website, language: lang })
                })
                    .then(function (response) { return response.json(); })
                    .then(function (result) {
                        if (result.ok) {
                            succeeded = true;
                            form.reset();
                            messageEl.textContent = lang === 'en' ? {{ (en.form.success_message or de.form.success_message) | json | safe }} : {{ de.form.success_message | json | safe }};
                            statusEl.setAttribute('role', 'status');
                            submitButton.textContent = lang === 'en' ? {{ (en.form.submitted_label or de.form.submitted_label) | json | safe }} : {{ de.form.submitted_label | json | safe }};
                        } else {
                            messageEl.textContent = lang === 'en' ? {{ (en.form.error_message or de.form.error_message) | json | safe }} : {{ de.form.error_message | json | safe }};
                            statusEl.setAttribute('role', 'alert');
                        }
                        statusEl.hidden = false;
                    })
                    .catch(function () {
                        messageEl.textContent = lang === 'en' ? {{ (en.form.error_message or de.form.error_message) | json | safe }} : {{ de.form.error_message | json | safe }};
                        statusEl.setAttribute('role', 'alert');
                        statusEl.hidden = false;
                    })
                    .finally(function () {
                        if (submitButton && !succeeded) {
                            submitButton.disabled = false;
                            submitButton.textContent = lang === 'en' ? {{ (en.form.submit_label or de.form.submit_label) | json | safe }} : {{ de.form.submit_label | json | safe }};
                        }
                    });
            });
        })();
    </script>

</body>
</html>
