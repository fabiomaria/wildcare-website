---
pagination:
  data: montagskursFeatured
  size: 1
  alias: occ
permalink: "montagskurs/{{ occ.date }}.html"
---
{%- set seoMeta = { title: 'Montagskurs' ~ (' mit ' ~ occ.teacher if occ.teacher else '') ~ ' — ' ~ occ.date_label_de ~ ' | Wild Care', description: (occ.note_de or 'Besonderer Montagskurs für Contact Improvisation in Graz.') ~ ' ' ~ occ.date_label_de ~ ', ' ~ occ.time_label ~ '.' } -%}
{%- set seoCanonical = 'https://wildcare.space/montagskurs/' ~ occ.date -%}
{%- set seoLocale = 'de_AT' -%}
{%- set seoFallbackImage = 'assets/images/social preview.jpg' -%}
{%- set seoFallbackImageAlt = 'Wild Care Contact Improvisation' -%}
{%- set seoFallbackImageWidth = 1200 -%}
{%- set seoFallbackImageHeight = 630 -%}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% include "partials/seo.njk" %}
  <script type="application/ld+json">{{ occ | featuredOccurrenceJsonLd | json | safe }}</script>
  <link rel="stylesheet" href="../css/styles.css?v={{ assetVersion }}">
</head>
<body>
  {% include "partials/nav.njk" %}
  <main class="page-hero"><div class="container">
    <p class="label" data-de="Montagskurs" data-en="Monday Class">Montagskurs</p>
    <h1>Montagskurs — <time datetime="{{ occ.start_local }}">{{ occ.date_label_de }}</time></h1>
    <p><time datetime="{{ occ.start_local }}">{{ occ.date_label_de }}</time>, {{ occ.time_label }}</p>
    {% if occ.teacher %}<p>{{ occ.teacher }}</p>{% endif %}
    <p data-de="{{ occ.note_de | attr }}" data-en="{{ occ.note_en | attr }}">{{ occ.note_de }}</p>
    {%- set calId = 'montagskurs' -%}
    {% include "partials/add-to-calendar.njk" %}
  </div></main>
  {% include "partials/footer.njk" %}
</body>
</html>
