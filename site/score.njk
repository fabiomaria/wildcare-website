<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kollektiv|ver|körpern — Wild Care</title>
<meta name="description" content="Dein Audio-Begleiter für Kollektiv|ver|körpern. Eine partizipative Performance von Wild Care.">
<link rel="stylesheet" href="css/styles.css">
<link rel="stylesheet" href="css/score.css">
</head>
<body class="score-body">
<main class="score-app">
  <header class="score-brand">
    <a href="/" aria-label="Wild Care Startseite">Wild Care<span>GRAZ</span></a>
    <span class="score-category">PARTIZIPATIVE PERFORMANCE</span>
  </header>

  <!-- ONBOARDING / EINFÜHRUNG -->
  <section class="score-screen" id="onboarding" aria-labelledby="screen-title">
    <div class="score-copy">
      <p class="score-eyebrow" id="step-label">Schön, dass du da bist.</p>
      <h1 id="screen-title">Willkommen bei<br>Kollektiv|ver|körpern</h1>
      <p id="screen-copy">Eine Einladung, deinem Körper und anderen zu begegnen.</p>

      <!-- Sprachauswahl nur am Anfang -->
      <div class="score-lang-picker" id="lang-picker">
        <span class="score-lang-label" id="lang-label">Text & Untertitel:</span>
        <div class="score-lang-buttons" role="group" aria-labelledby="lang-label">
          <button type="button" class="score-lang-btn active" id="btn-lang-de" data-lang="de" aria-pressed="true">DE</button>
          <button type="button" class="score-lang-btn" id="btn-lang-en" data-lang="en" aria-pressed="false">EN</button>
        </div>
        <p class="score-lang-note" id="lang-note">* Original-Tonspur ist auf Deutsch</p>
      </div>
    </div>

    <div class="score-bottom">
      <div id="pager" class="score-pager" aria-label="Einführung"></div>
      <button class="score-next" id="next" aria-label="Weiter">
        <span id="next-label">Weiter</span> <span aria-hidden="true">⟶</span>
      </button>
      <button class="score-back" id="back" hidden>Zurück</button>

      <!-- Hintergrund-Ladeanzeige -->
      <div class="score-download-wrap" id="download-wrap" aria-live="polite">
        <div class="score-download-bar"><div id="download-progress" class="score-download-fill"></div></div>
        <span id="download-label" class="score-download-label">Laden für Offline …</span>
      </div>
    </div>
  </section>

  <!-- PLAYER -->
  <section class="score-screen" id="player" aria-labelledby="player-title" hidden>
    <div class="score-player-header">
      <p class="score-eyebrow" id="chapter-label">Intro</p>
      <h1 id="player-title">Kollektiv|ver|körpern</h1>
    </div>

    <div class="score-player-area">
      <div class="score-timeline" role="img" aria-label="Wiedergabefortschritt" id="timeline">
        <div class="score-track"><div id="progress"></div></div>
        <div id="nodes"></div>
      </div>
      <div class="score-controls">
        <button id="play" class="score-play" aria-label="Wiedergabe starten" aria-pressed="false">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path id="play-icon" d="M17 10 L39 24 L17 38 Z"/></svg>
        </button>
        <button id="reset" class="score-rewind" aria-label="Zum Anfang dieses Abschnitts springen" title="Zum Anfang dieses Abschnitts springen">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path d="M11 7 4 13l7 6M5 13h13a9 9 0 1 1-8 13"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Text / Untertitel Anzeige -->
    <div class="score-subtitles" id="subtitles" aria-live="polite" aria-atomic="true">
      <p class="score-cue-text" id="cue-text"></p>
    </div>

    <div class="score-player-footer">
      <button class="score-back" id="help">Hinweise noch einmal lesen</button>
    </div>
  </section>

  <!-- Audio-Element für die echte Wiedergabe -->
  <audio id="audio" preload="auto" playsinline src="assets/score/audio.mp3"></audio>
</main>
<script src="js/score.js" defer></script>
</body>
</html>
