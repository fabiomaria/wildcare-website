---
permalink: programm.html
---
{% from "partials/icon.njk" import icon %}
{%- set de = cms.pages.programm.de -%}
{%- set en = cms.pages.programm.en -%}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- set seoMeta = de.meta -%}
    {%- set seoCanonical = "https://wildcare.space/programm" -%}
    {%- set seoAlternateLocale = "en_US" -%}
    {% include "partials/seo.njk" %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,700;1,9..144,300;1,9..144,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="css/styles.css?v={{ assetVersion }}">
    <script async src="https://tally.so/widgets/embed.js"></script>
</head>
<body>

    {%- set navActive = "programm" -%}
    {% include "partials/nav.njk" %}

    <!-- ================================
         HERO
         ================================ -->

    <header class="page-hero">
        <div class="container">
            <p class="label fade-up"
                data-de="{{ de.hero.label | attr }}"
                data-en="{{ en.hero.label | attr }}">{{ de.hero.label }}</p>
            <h1 class="fade-up delay-1"
                data-de="{{ de.hero.heading | attr }}"
                data-en="{{ en.hero.heading | attr }}">{{ de.hero.heading }}</h1>
            <p class="fade-up delay-2"
                data-de="{{ de.hero.intro | attr }}"
                data-en="{{ en.hero.intro | attr }}">{{ de.hero.intro }}</p>
        </div>
    </header>

    <!-- ================================
         UPCOMING EVENTS SLIDER
         ================================ -->

    {%- set upcomingVariant = "full" -%}
    {% include "partials/upcoming-slider.njk" %}

    <!-- ================================
         LABS
         ================================ -->

    <section class="labs-section">
        <div class="container">
            <div class="section-header fade-up" style="margin-bottom: 40px;">
                <p class="label" data-de="{{ de.labs.label | attr }}" data-en="{{ en.labs.label | attr }}">{{ de.labs.label }}</p>
                <h2 data-de="{{ de.labs.heading | attr }}" data-en="{{ en.labs.heading | attr }}">{{ de.labs.heading }}</h2>
                <p class="labs-intro" data-de="{{ de.labs.intro | attr }}" data-en="{{ en.labs.intro | attr }}">{{ de.labs.intro }}</p>
            </div>
            <div class="labs-grid">
                {% for item in de.labs.items %}
                {% set enItem = en.labs.items[loop.index0] %}
                <article class="card lab-card fade-up delay-{{ loop.index }}">
                    <div class="lab-card-top">
                        <h3 data-de="{{ item.name | attr }}" data-en="{{ enItem.name | attr }}">{{ item.name }}</h3>
                        <span class="lab-status" data-de="{{ item.status_label | attr }}" data-en="{{ enItem.status_label | attr }}">{{ item.status_label }}</span>
                    </div>
                    <p data-de="{{ item.text | attr }}" data-en="{{ enItem.text | attr }}">{{ item.text }}</p>
                    {% if item.link %}<a class="lab-link" href="{{ item.link | cleanUrl }}" data-de="Mehr erfahren" data-en="Learn more">Mehr erfahren</a>{% endif %}
                </article>
                {% endfor %}
            </div>
            <div class="labs-cta fade-up">
                <p data-de="{{ de.labs.cta_text | attr }}" data-en="{{ en.labs.cta_text | attr }}">{{ de.labs.cta_text }}</p>
                <a href="{{ de.labs.cta_url | cleanUrl }}" class="btn btn-ghost" data-de="{{ de.labs.cta_button | attr }}" data-en="{{ en.labs.cta_button | attr }}">{{ de.labs.cta_button }}</a>
            </div>
        </div>
    </section>

    <!-- ================================
         MONTAGSKURS
         ================================ -->

    <section class="montagskurs">
        <div class="container">
            <div class="section-header fade-up" style="margin-bottom: 56px;">
                <p class="label"
                    data-de="{{ de.core.label | attr }}"
                    data-en="{{ en.core.label | attr }}">{{ de.core.label }}</p>
                <h2
                    data-de="{{ de.core.heading | attr }}"
                    data-en="{{ en.core.heading | attr }}">{{ de.core.heading }}</h2>
            </div>

            <div class="montagskurs-layout">
                <div class="info-card fade-up delay-1">
                    <div class="info-card-title"
                        data-de="{{ de.core.info_title | attr }}"
                        data-en="{{ en.core.info_title | attr }}">{{ de.core.info_title }}</div>

                    {% for row in de.core.rows %}
                    {%- set enRow = en.core.rows[loop.index0] -%}
                    <div class="info-row">
                        <div class="info-row-icon">
                            {{ icon(row.icon) }}
                        </div>
                        <div class="info-row-content">
                            <div class="info-row-label"
                                data-de="{{ row.label | attr }}"
                                data-en="{{ enRow.label | attr }}">{{ row.label }}</div>
                            <div class="info-row-value"{% if row.value != enRow.value %}
                                data-de="{{ row.value | attr }}"
                                data-en="{{ enRow.value | attr }}"{% endif %}>{{ row.value | safe }}</div>
                        </div>
                    </div>

                    {% endfor %}
                    <div class="info-card-cta" style="display: flex; gap: var(--space-sm);">
                        <button class="btn btn-primary" style="flex: 1; justify-content: center;" data-tally-open="nplWX8" data-tally-emoji-text="&#x1F44B;" data-tally-emoji-animation="wave"
                            data-de="{{ de.core.register_label | attr }}"
                            data-en="{{ en.core.register_label | attr }}">{{ de.core.register_label }}</button>
                        <a href="montagskurs" class="btn btn-secondary" style="flex: 1; justify-content: center;"
                            data-de="{{ de.core.more_label | attr }}"
                            data-en="{{ en.core.more_label | attr }}">{{ de.core.more_label }}</a>
                    </div>
                    {%- set calId = "montagskurs" -%}
                    {% include "partials/add-to-calendar.njk" %}
                </div>

                <div class="montagskurs-description fade-up delay-2">
                    <h2
                        data-de="{{ de.core.description_heading | attr }}"
                        data-en="{{ en.core.description_heading | attr }}">{{ de.core.description_heading }}</h2>
                    {% for paragraph in de.core.paragraphs %}
                    <p
                        data-de="{{ paragraph.text | attr }}"
                        data-en="{{ en.core.paragraphs[loop.index0].text | attr }}">{{ paragraph.text }}</p>
                    {% endfor %}
                    <p class="quote"
                        data-de="{{ de.core.quote | attr }}"
                        data-en="{{ en.core.quote | attr }}">{{ de.core.quote }}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================
         AKTUELLE PROJEKTE
         ================================ -->

    {% if cms.workshops.current.length %}
    <section>
        <div class="container">
            <div class="section-header fade-up" style="margin-bottom: 48px;">
                <p class="label"
                    data-de="{{ de.projects.label | attr }}"
                    data-en="{{ en.projects.label | attr }}">{{ de.projects.label }}</p>
                <h2
                    data-de="{{ de.projects.heading | attr }}"
                    data-en="{{ en.projects.heading | attr }}">{{ de.projects.heading }}</h2>
            </div>

            {% for workshop in cms.workshops.current %}
            {%- set cardDe = workshop.de.card -%}
            {%- set cardEn = workshop.en.card -%}
            {%- set factsDe = workshop.de.facts -%}
            {%- set factsEn = workshop.en.facts -%}
            <div class="projekt-card fade-up delay-{{ loop.index }}">
                <div class="projekt-card-accent"></div>
                <div class="projekt-card-body">
                    <div class="projekt-card-meta">
                        {% for tag in cardDe.tags %}
                        {%- set tagEn = cardEn.tags[loop.index0] -%}
                        <span class="projekt-tag{% if tag.style == 'moss' %} projekt-tag-moss{% endif %}"
                            data-de="{{ tag.label | attr }}"
                            data-en="{{ tagEn.label | attr }}">{{ tag.label }}</span>
                        {% endfor %}
                    </div>
                    <h3{% if workshop.de.title != workshop.en.title %} data-de="{{ workshop.de.title | attr }}" data-en="{{ workshop.en.title | attr }}"{% endif %}>{{ workshop.de.title }}</h3>
                    <div class="projekt-card-subtitle"{% if cardDe.subtitle != cardEn.subtitle %} data-de="{{ cardDe.subtitle | attr }}" data-en="{{ cardEn.subtitle | attr }}"{% endif %}>{{ cardDe.subtitle }}</div>
                    <p{% if cardDe.summary != cardEn.summary %} data-de="{{ cardDe.summary | attr }}" data-en="{{ cardEn.summary | attr }}"{% endif %}>{{ cardDe.summary }}</p>
                    
                    <div class="projekt-details">
                        <div class="projekt-detail">
                            {{ icon("calendar") }}
                            <span
                                data-de="{{ factsDe.date | attr }}"
                                data-en="{{ factsEn.date | attr }}">{{ factsDe.date }}</span>
                        </div>
                        <div class="projekt-detail">
                            {{ icon("location") }}
                            <span data-de="{{ factsDe.location | attr }}" data-en="{{ factsEn.location | attr }}">{{ factsDe.location }}</span>
                        </div>
                        <div class="projekt-detail">
                            {{ icon("cost") }}
                            <span
                                data-de="{{ factsDe.price | attr }}"
                                data-en="{{ factsEn.price | attr }}">{{ factsDe.price | safe }}</span>
                        </div>
                        <div class="projekt-detail">
                            {{ icon("people") }}
                            <span data-de="{{ factsDe.duration | attr }}" data-en="{{ factsEn.duration | attr }}">{{ factsDe.duration }}</span>
                        </div>
                    </div>

                    <div style="margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: var(--border-subtle); display: flex; gap: var(--space-sm); flex-wrap: wrap;">
                        <a href="{{ workshop.registration_url }}" class="btn btn-primary" data-de="{{ workshop.de.registration.label | attr }}" data-en="{{ workshop.en.registration.label | attr }}">{{ workshop.de.registration.label }}</a>
                        {% if workshop.has_detail_page %}
                        <a href="{{ workshop.href | cleanUrl }}" class="btn btn-secondary"
                            data-de="{{ (cardDe.detail_label or cms.site.de.workshop_ui.detail_label) | attr }}"
                            data-en="{{ (cardEn.detail_label or cms.site.en.workshop_ui.detail_label) | attr }}">{{ cardDe.detail_label or cms.site.de.workshop_ui.detail_label }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <!-- ================================
         CTA
         ================================ -->

    <section class="cta-section">
        <div class="container fade-up">
            <p class="label" style="color: var(--warmwhite); opacity: 0.5; margin-bottom: 16px;"
                data-de="{{ de.cta.label | attr }}"
                data-en="{{ en.cta.label | attr }}">{{ de.cta.label }}</p>
            <h2
                data-de="{{ de.cta.heading | attr }}"
                data-en="{{ en.cta.heading | attr }}">{{ de.cta.heading }}</h2>
            <p
                data-de="{{ de.cta.text | attr }}"
                data-en="{{ en.cta.text | attr }}">{{ de.cta.text }}</p>
            <a href="kontakt" class="btn btn-primary"
                data-de="{{ de.cta.button | attr }}"
                data-en="{{ en.cta.button | attr }}">{{ de.cta.button }}</a>
        </div>
    </section>

    <!-- ================================
         FOOTER
         ================================ -->

    {%- set footerConnectHeadingDe = "Verbinden" -%}
    {%- set footerConnectHeadingEn = "Connect" -%}
    {% include "partials/footer.njk" %}

    <!-- ================================
         SCRIPTS
         ================================ -->

    <script>
        // Scroll animations
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px'
        });

        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));

        // Mobile nav toggle
        const navToggle = document.querySelector('.nav-toggle');
        const navLinks = document.querySelector('.nav-links');
        if (navToggle) {
            navToggle.addEventListener('click', () => {
                navLinks.classList.toggle('open');
            });
        }
    </script>
    <script src="js/i18n.js"></script>
    <script src="js/upcoming-slider.js"></script>

</body>
</html>
