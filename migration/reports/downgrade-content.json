{
  "collections": [
    "workshops",
    "site",
    "pages",
    "journal",
    "legal",
    "venues",
    "events"
  ],
  "lossy_fields": [
    "global.schedule.*",
    "global.venue",
    "global.registration.availability",
    "global.event_type",
    "global.page_mode"
  ],
  "mode": "write",
  "outputs": [
    "migration/downgraded/workshops/bewegungsrevolution.yaml",
    "migration/downgraded/workshops/cellular-touch.yaml",
    "migration/downgraded/workshops/how-we-move-together.yaml",
    "migration/downgraded/site/site.yaml",
    "migration/downgraded/pages/index.yaml",
    "migration/downgraded/pages/journal.yaml",
    "migration/downgraded/pages/kontakt.yaml",
    "migration/downgraded/pages/mitmachen.yaml",
    "migration/downgraded/pages/montagskurs.yaml",
    "migration/downgraded/pages/programm.yaml",
    "migration/downgraded/pages/team.yaml",
    "migration/downgraded/journal/bewegungsrevolution.md",
    "migration/downgraded/journal/bewegungsrevolution.en.md",
    "migration/downgraded/journal/warum-ci.md",
    "migration/downgraded/journal/warum-ci.en.md",
    "migration/downgraded/legal/datenschutz.md",
    "migration/downgraded/legal/impressum.md"
  ],
  "warnings": [
    "venue and event records are v2-only and have no v1 downgrade target"
  ]
}
